# Copy to .env and fill in. Never commit .env.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From Resend dashboard -> Webhooks -> your endpoint -> Signing Secret.
# Required for /webhooks/resend to accept anything -- without it every
# request is rejected as unsigned, so bounces/complaints won't auto-suppress.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Optional, for the reply poller (not built yet)
IMAP_HOST=
IMAP_PASSWORD_CONTACT=
IMAP_PASSWORD_SALES=
IMAP_PASSWORD_INFO=
IMAP_PASSWORD_HELLO=
